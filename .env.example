# PitchPerfect AI - Environment Variables Configuration

# Supabase Database & Auth (Get these from Supabase project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Supabase Service Role Key (for administrative scripts, if needed)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Gemini AI API Configuration (Get from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
